{
  "@context": "https://www.w3.org/ns/activitystreams",
  "type": "OrderedCollection",
  "summary": {{ .Site.Title | jsonify }},
  "orderedItems": [
  {{- range $i, $e := first 10 .Site.RegularPages -}}
  {{- if $i -}}, {{- end -}}
    {
      {{- if .Params.link -}}
       "name": {{ .Title | jsonify }},
      "type": "Link",
       "href": {{ .Params.link | jsonify }},
       "hreflang": {{ "en" | jsonify }},
       "mediaType": {{ "text/html" | jsonify }},
      {{- else if eq .Type "photos" -}}
      "type": "Image",
          {{- with .Resources.ByType "image" -}}{{- range first 1 . -}}
       "href": {{ .Permalink | jsonify }},
       "mediaType": {{ "image/jpeg" | jsonify }},
          {{- end -}}{{- end -}}
        {{- else -}}
      "type": "Article",
       "name": {{ .Title | jsonify }},
      "content": {{ .Summary | jsonify }},
      {{- end -}}
       "published": {{ .Date.Format "2006-01-02T15:04:05Z07:00" | jsonify }}
    }
    {{ end -}}
  ]
}
