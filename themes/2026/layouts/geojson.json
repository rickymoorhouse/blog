{
 "type":"FeatureCollection",
 "features": [
{{- $first := true -}}
{{- range hugo.Data.travel -}}
{{- if .lat -}}
{{- if not $first }},{{ end -}}
{{- $first = false -}}
  {
   "type":"Feature",
   "geometry": {
    "type":"Point",
    "coordinates": [{{ .lng }},{{ .lat }}]
   },
   "properties": {
     "title":{{ .title | jsonify }},
     {{ if .photo }}"image":{{ .photo | jsonify }},{{ end }}
     {{ if .link }}"url":{{ .link | jsonify }},{{ end }}
     "years": [{{ if .years }}{{ range $j, $year := .years }}{{ if $j }},{{ end }}{{ $year | jsonify }}{{ end }}{{ else }}{{ $date := or .date .datePosted }}{{ $y := substr $date 0 4 }}{{ if and $date (not (eq $y "None")) (not (eq $y "Uni")) }}{{ $y | jsonify }}{{ end }}{{ end }}],
    "marker-symbol":"circle",
    "marker-size":"small",
     "marker-color":{{ $.Site.Params.tertiary | default "#869ba0" | jsonify }}
   }
   }
 {{- end -}}
 {{- end }}
  ]
}
